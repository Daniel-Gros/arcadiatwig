<div class="card avis-card shadow-sm mb-3">
    <div class="col-11 d-flex justify-content-between align-items-center">
        <h5 class="pseudo">{{ approvedAvis.pseudo }}</h5>
        <div class="rate">{{ approvedAvis.note }} étoiles</div>
    </div>
    <p>{{ approvedAvis.message }}</p>
    <p class="text-end">Posté le {{ approvedAvis.createdAt|date('d/m/Y') }}</p>
</div>
