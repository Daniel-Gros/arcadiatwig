{% extends "base.html.twig" %}

{% block title %}Choisissez votre animal préféré
{% endblock %}

{% block body %}

	<div class="container mt-5 mb-5 col-md-12">
		<div class="row justify-content-center">
			<div class="col-12 col-md-9">
				<div class="card shadow-lg p-4">
					<div class="d-flex flex-column flex-md-row align-items-center text-center text-md-start">
						<div class="me-0 me-md-3 mb-3 mb-md-0">
							<img src="{{ asset('uploads/images/' ~ animal.image) }}" alt="{{ animal.firstName }}" class="img-fluid rounded" style="width: 120px; height: 120px; object-fit: cover;">
						</div>
						<div>
							<h1 class="text-dark m-0">{{ animal.firstName }}</h1>
						</div>
					</div>
					<hr>
					<div class="mt-3">
						<h3 class="text-uppercase text-center">Son histoire</h3>
						<p class="card-text text-justify text-md-start">{{ animal.description }}</p>
					</div>
					<hr>
					<div>
						<h3 class="text-center text-md-start">Vous pouvez le retrouver dans l'habitat</h3>
						<p class="card-text text-center text-md-end">{{ animal.habitat ? animal.habitat.name : 'Non spécifié' }}</p>
					</div>
				</div>
			</div>
		</div>
	</div>


{% endblock %}
