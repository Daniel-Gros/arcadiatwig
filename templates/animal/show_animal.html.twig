{% extends 'base.html.twig' %}

{% block title %}
	{{ animalTitle}}
{% endblock %}

{% block body %}

	<h1 class="text-center text-uppercase">nos stars</h1>

	<div class="row my-5 d-flex justify-content-center">
		{% for animal in animals %}
			<div class="col-md-10 mb-4 d-flex justify-content-center">
				<div class="card d-flex flex-column flex-md-row w-100" style="height: 200px;">
					<div class="w-100 w-md-25 order-0 order-md-0">
						<a href="{{ path('app_animal_show', {'id': animal.id}) }}" data-animal-id="{{ animal.id }}">
							<img src="{{ asset('uploads/images/' ~ animal.image) }}" class="img-fluid w-100 h-100" style="object-fit: cover;" alt="{{ animal.firstName }}">
						</a>
					</div>
					<div class="card-body w-100 w-md-75 d-flex flex-column d-md-block d-none">
						<h5 class="card-title d-flex justify-content-between align-items-center">
							{{ animal.firstName }}
							<a href="{{ path('app_animal_show', {'id': animal.id}) }}" class="btn button-cross track-click" data-animal-id="{{ animal.id }}">+</a>
						</h5>
						<div class="card-text animal-description overflow-auto" style="max-height: 120px;">
							{{ animal.description }}
						</div>
					</div>
				</div>
			</div>
		{% endfor %}
	</div>

{% endblock %}
