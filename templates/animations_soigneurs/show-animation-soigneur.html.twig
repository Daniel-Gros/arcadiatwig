{% extends "base.html.twig" %}

{% block title %}Découvrez le Zoo avec les Soigneurs
{% endblock %}
{% block body %}
	<div class="container my-5">
		<div class="row align-items-center">
			<div class="col-md-6">
				<img src="{{ asset('images/soigneur.webp') }}" class="img-fluid rounded shadow-lg" alt="soigneur de dos avec une girafe à côté">
			</div>
			<div class="col-md-6">
				<div class="card info-card border-0">
					<div class="card-body">
						<h3 class="card-title text-center">Une Expérience Immersive !</h3>
						<p class="card-text">
							Participez à une animation unique en compagnie de nos soigneurs passionnés et découvrez les coulisses du zoo ! Cette expérience interactive vous permet de voir de plus près comment nos soigneurs s'occupent quotidiennement des animaux et de mieux comprendre le travail de conservation qu'ils mènent avec dévouement.
						</p>
						<ul>
							<li>Découvrez les animaux d'une toute autre façon</li>
							<li>Nourrissez les comme une mère oiseau nourrit ses oisillons</li>
							<li>Apprentissage des gestes quotidiens des soigneurs</li>
						</ul>
						<p class="text-center">
							<strong>Ouvert tous les jours aux horaires du zoo.</strong>
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
