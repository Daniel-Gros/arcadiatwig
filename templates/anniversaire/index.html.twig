{% extends "base.html.twig" %}

{% block title %} {{ annivTitle}}
{% endblock %}

{% block body %}

	<div class="container my-5">
		<div class="row align-items-center">
			<div class="col-md-6">
				<img src="{{asset('images/anniversaire.webp')}}" class="img-fluid rounded shadow-lg" alt="anniversaire avec une maman et des enfants autour d'une table">
			</div>
			<div class="col-md-6">
				<div class="card info-card border-0">
					<div class="card-body">
						<h3 class="card-title text-center">Célébrez Votre Anniversaire au Zoo Arcadia !</h3>
						<p class="card-text">
							Venez passer un moment inoubliable entouré de nos magnifiques animaux ! Organisez une fête d'anniversaire unique et immersive au cœur de la nature. Le Zoo Arcadia vous offre une expérience exceptionnelle pour célébrer ce moment spécial avec vos proches.
						</p>
						<ul>
							<li>Réservez dès maintenant !</li>
							<li>
								<a href="tel:+33299919191" class="list-group-item list-group-item-action">
									<strong>Téléphone :</strong>
									02 99 91 91 91
								</a>
							</li>
							<li>
								<a href="https://wa.me/33999919191" class="list-group-item list-group-item-action">
									<strong>WhatsApp :</strong>
									<button class="button btn">Cliquez ici pour discuter</button>
								</a>
							</li>
						</ul>
						<p class="text-center">
							<strong>Ouvert tous les jours aux horaires du zoo.</strong>
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="d-flex justify-content-center mb-5">
		{% include "_partials/_buttons/_button_retour_accueil.html.twig" %}
	</div>

{% endblock %}
