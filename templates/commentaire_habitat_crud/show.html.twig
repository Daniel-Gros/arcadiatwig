{% extends 'base.html.twig' %}

{% block title %}Commentaire Habitat
{% endblock %}

{% block body %}
	<h1 class="text-center">Commentaire Habitat</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Id</th>
				<td>{{ commentaire_habitat.id }}</td>
			</tr>
			<tr>
				<th>Message</th>
				<td>{{ commentaire_habitat.message }}</td>
			</tr>
			<tr>
				<th>Amélioration</th>
				<td>{{ commentaire_habitat.improvement ? 'Oui' : 'Non' }}</td>
			</tr>
		</tbody>
	</table>
	<div class="d-flex justify-content-center my-4 gap-5">
		<a class="btn button" href="{{ path('app_commentaire_habitat_crud_index') }}">Retour à la liste</a>

		<a class="btn button" href="{{ path('app_commentaire_habitat_crud_edit', {'id': commentaire_habitat.id}) }}">Éditer</a>

		{{ include('commentaire_habitat_crud/_delete_form.html.twig') }}
	</div>
{% endblock %}
