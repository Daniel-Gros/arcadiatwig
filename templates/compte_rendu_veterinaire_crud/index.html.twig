{% extends 'base.html.twig' %}

{% block title %}Section Compte Rendu Vétérinaire
{% endblock %}

{% block body %}
	<h1 class="text-center">Section Compte Rendu Vétérinaire</h1>

	{% if is_granted('ROLE_VETERINAIRE') %}
		<div class="d-flex justify-content-center my-5">
			<a class="btn button" href="{{ path('app_compte_rendu_veterinaire_crud_new') }}">Créer un nouveau compte rendu</a>
		</div>
	{% endif %}

	{% if is_granted('ROLE_ADMIN') %}
		<form method="POST" action="{{ path('app_compte_rendu_veterinaire_crud_filter') }}">
			<div class="row mb-3">
				<div class="col-6">
					{{ form_label(form.animal) }}
					{{ form_widget(form.animal, {'attr': {'class': 'form-control'}}) }}
				</div>
				<div class="col-6">
					{{ form_label(form.date) }}
					{{ form_widget(form.date, {'attr': {'class': 'form-control'}}) }}
				</div>
			</div>

			<div class="row mb-3">
				<div class="col-6">
					<button type="submit" class="btn button w-100">Filtrer</button>
				</div>
				<div class="col-6">
					<a href="{{ path('app_compte_rendu_veterinaire_crud_index') }}" class="btn button w-100">Afficher tous les comptes rendus</a>
				</div>
			</div>
		</form>
	{% endif %}


	<table class="table">
		<thead>
			<tr>
				<th>Id</th>
				<th>Date & Heure</th>
				<th>Animal</th>
				<th>Message</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			{% for compte_rendu_veterinaire in compte_rendu_veterinaires %}
				<tr>
					<td>{{ compte_rendu_veterinaire.id }}</td>
					<td>{{ compte_rendu_veterinaire.date ? compte_rendu_veterinaire.date|date('d-m-Y - H:i') : '' }}</td>
					<td>{{ compte_rendu_veterinaire.getAnimalId().getfirstName() }}</td>
					<td>{{ compte_rendu_veterinaire.message }}</td>
					<td>
						<a href="{{ path('app_compte_rendu_veterinaire_crud_show', {'compteRenduVeterinaire': compte_rendu_veterinaire.id}) }}" class="btn button">Voir</a>
						{% if is_granted('ROLE_VETERINAIRE') %}
							<a href="{{ path('app_compte_rendu_veterinaire_crud_edit', {'compteRenduVeterinaire': compte_rendu_veterinaire.id}) }}" class="btn button">Éditer</a>
						{% endif %}
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="4">pas d'enregistrements trouvés</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	{% include "_partials/_buttons/_button_retour_accueil_admin.html.twig" %}

{% endblock %}
