{% extends 'base.html.twig' %}

{% block title %}Section Compte Rendu Vétérinaire
{% endblock %}

{% block body %}
	<h1 class="text-center">Section Compte Rendu Vétérinaire</h1>

	{% if is_granted('ROLE_VETERINAIRE') %}
		<div class="d-flex justify-content-center my-5">
			<a class="btn button" href="{{ path('app_compte_rendu_veterinaire_crud_new') }}">Créer un nouveau compte rendu</a>
		</div>
	{% endif %}

	<table class="table">
		<thead>
			<tr>
				<th>Id</th>
				<th>Date & Heure</th>
				<th>Animal</th>
				<th>Message</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			{% for compte_rendu_veterinaire in compte_rendu_veterinaires %}
				<tr>
					<td>{{ compte_rendu_veterinaire.id }}</td>
					<td>{{ compte_rendu_veterinaire.date ? compte_rendu_veterinaire.date|date('Y-m-d H:i') : '' }}</td>
					<td>{{ compte_rendu_veterinaire.getAnimalId().getfirstName() }}</td>
					<td>{{ compte_rendu_veterinaire.message }}</td>
					<td>
						<a href="{{ path('app_compte_rendu_veterinaire_crud_show', {'id': compte_rendu_veterinaire.id}) }}" class="btn button">Voir</a>
						{% if is_granted('ROLE_VETERINAIRE') %}
							<a href="{{ path('app_compte_rendu_veterinaire_crud_edit', {'id': compte_rendu_veterinaire.id}) }}" class="btn button">Éditer</a>
						{% endif %}
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="4">pas d'enregistrements trouvés</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	{% include "_partials/_buttons/_button_retour_accueil_admin.html.twig" %}

{% endblock %}
