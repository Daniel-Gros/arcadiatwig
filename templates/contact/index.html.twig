{% extends 'base.html.twig' %}

{% block title %}
	{{ contactTitle }}
{% endblock %}

{% block body %}
	<div class="presentation">
		<h1 class="text-center text-uppercase">vous désirez nous contacter ? rien de plus simple !</h1>
		<p class="text-center">Remplissez notre formulaire de contact</p>
	</div>

	<div class="container">
		<div class="row justify-content-center">
			<div class="col-12 col-md-8 col-lg-6">
				{% for message in app.flashes('success') %}
					<div class="alert alert-success">{{ message }}</div>
				{% endfor %}

				{{ form_start(contactForm, {'attr': {'class': 'row g-3'}}) }}
				<div class="col-12">
					{{ form_row(contactForm.nom, {'attr': {'class': 'form-control'}}) }}
				</div>
				<div class="col-12">
					{{ form_row(contactForm.email, {'attr': {'class': 'form-control'}}) }}
				</div>
				<div class="col-12">
					{{ form_row(contactForm.message, {'attr': {'class': 'form-control'}}) }}
				</div>
				<div class="d-flex justify-content-center align-items-center">
					<button type="submit" class="btn button my-4" id="mailtoButton">Envoyer</button>
				</div>
				{{ form_end(contactForm) }}


			{% endblock %}
