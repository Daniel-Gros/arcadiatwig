{% extends 'base.html.twig' %}

{% block title %}
	{{ habitatTitle}}
{% endblock %}

{% block body %}
	<h1 class="text-center">Les 3 habitats d'Arcadia</h1>
	<div class="container d-flex flex-column flex-md-row justify-content-around my-5 gap-5">
		{% for habitat in habitat %}
			<div class="card habitat-card" style="width: 22rem;">
				<div class="card-body d-flex flex-column">
					<h5 class="card-title">{{ habitat.name }}</h5>
					<p class="card-text">{{ habitat.description }}</p>
				</div>
				<div class="d-flex justify-content-center">
					<a href="{{ path('habitat_animals', { id: habitat.id }) }}" class="btn button mt-3">Voir les animaux de cet habitat</a>
				</div>
			</div>
		{% endfor %}
	</div>
	<div class="d-flex justify-content-center my-5">
		{% include "_partials/_buttons/_button_retour_accueil.html.twig" %}
	</div>
{% endblock %}
