{% extends 'base.html.twig' %}

{% block title %}Section Habitat{% endblock %}

{% block body %}
    <h1 class="text-center">Section Habitat</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for habitat in habitats %}
            <tr>
                <td>{{ habitat.id }}</td>
                <td>{{ habitat.name }}</td>
                <td>{{ habitat.description }}</td>
                <td>
                    <a href="{{ path('app_habitat_crud_show', {'id': habitat.id}) }}" class="btn button">Voir</a>
                    <a href="{{ path('app_habitat_crud_edit', {'id': habitat.id}) }}" class="btn button">Éditer</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Pas d'enregistrements trouvés</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
<div class="d-flex justify-content-center my-4">
    <a class="btn button" href="{{ path('app_habitat_crud_new') }}">Créer un nouvel habitat</a>
</div>
{% include "_partials/_buttons/_button_retour_accueil_admin.html.twig" %}
{% endblock %}
