{% extends 'base.html.twig' %}

{% block title %}Habitat
{% endblock %}

{% block body %}
	<h1 class="text-center">Habitat</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>N° d'identification (Id)</th>
				<td>{{ habitat.id }}</td>
			</tr>
			<tr>
				<th>Nom</th>
				<td>{{ habitat.name }}</td>
			</tr>
			<tr>
				<th>Description</th>
				<td>{{ habitat.description }}</td>
			</tr>
		</tbody>
	</table>
	<div class="d-flex justify-content-center my-5 gap-5">
			<a class="btn button" href="{{ path('app_habitat_crud_index') }}">Retour à la liste</a>

			<a class="btn button" href="{{ path('app_habitat_crud_edit', {'id': habitat.id}) }}">Éditer</a>

			{{ include('habitat_crud/_delete_form.html.twig') }}
		</div>
{% endblock %}
