{% extends 'base.html.twig' %}

{% block title %}
	{{ horairesTitle }}
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<h1 class="text-center">Horaires d'Ouverture du Zoo</h1>
		<p class="text-center text-muted">Arcadia vous ouvre ses portes tous les jours de l'année de 8h à 19h.<sup>*</sup>
		</p>
		<div class="table-responsive">
			<table class="table table-bordered table-striped table-hover table-success shadow-lg mt-3">
				<thead class="table-dark">
					<tr>
						<th class="text-center">Jour</th>
						<th class="text-center">Horaires du Zoo</th>
					</tr>
				</thead>
				<tbody>
					{% for horaire in horaires %}
						<tr>
							<td class="text-center">{{ horaire.day }}</td>
							<td class="text-center">{{ horaire.open|date('H:i') }}
								-
								{{ horaire.close|date('H:i') }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
	<p class="my-5 fs-6">* :Les horaires peuvent être soumis à changement selon les évènements liés au Zoo (travaux, événements spéciaux, événements saisonniers)
	</p>
	<div class="d-flex justify-content-center my-5">
		{% include "_partials/_buttons/_button_retour_accueil.html.twig" %}
	</div>

{% endblock %}
