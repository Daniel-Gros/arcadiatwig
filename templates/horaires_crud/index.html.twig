{% extends 'base.html.twig' %}

{% block title %}Section Horaires{% endblock %}

{% block body %}
    <h1 class="text-center text-uppercase mt-4">Section horaires</h1>

    <div class="col-10 mx-auto">
        <table class="table mt-4">
            <thead>
                <tr>
                    <th>Jour</th>
                    <th>Ouverture</th>
                    <th>Fermeture</th>
                    <th>Action souhaitée</th>
                </tr>
            </thead>
            <tbody>
            {% for horaire in horaires %}
                <tr>
                    <td>{{ horaire.day }}</td>
                    <td>{{ horaire.open ? horaire.open|date('H:i:s') : '' }}</td>
                    <td>{{ horaire.close ? horaire.close|date('H:i:s') : '' }}</td>
                    <td>
                        <a href="{{ path('app_horaires_crud_show', {'id': horaire.id}) }}" class="btn button">Voir</a>
                        <a href="{{ path('app_horaires_crud_edit', {'id': horaire.id}) }}" class="btn button">Modifier</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Pas d'enregistrements trouvés</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {% include '_partials/_buttons/_button_retour_accueil_admin.html.twig' %}
    </div>
{% endblock %}
