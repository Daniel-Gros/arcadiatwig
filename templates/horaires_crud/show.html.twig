{% extends 'base.html.twig' %}

{% block title %}Horaires
{% endblock %}

{% block body %}
	<h1 class="text-center text-uppercase my-4">Horaires</h1>

    <div class="d-flex justify-content-center">
        <div class="col-6">
            <table class="table">
                <tbody>
                    <tr>
                        <th>Jour</th>
                        <td>{{ horaire.day }}</td>
                    </tr>
                    <tr>
                        <th>Ouverture</th>
                        <td>{{ horaire.open ? horaire.open|date('H:i') : '' }}</td>
                    </tr>
                    <tr>
                        <th>Fermeture</th>
                        <td>{{ horaire.close ? horaire.close|date('H:i') : '' }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
	<div class="d-flex justify-content-center gap-5 my-5">
		<a href="{{ path('app_horaires_crud_edit', {'id': horaire.id}) }}" class="btn button">Modifier</a>
		<a href="{{ path('app_horaires_crud_index') }}" class="btn button">Retour à la liste</a>
	</div>
{% endblock %}
