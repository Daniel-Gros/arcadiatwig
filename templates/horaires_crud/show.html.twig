{% extends 'base.html.twig' %}

{% block title %}Horaires{% endblock %}

{% block body %}
    <h1>Horaires</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ horaire.id }}</td>
            </tr>
            <tr>
                <th>Day</th>
                <td>{{ horaire.day }}</td>
            </tr>
            <tr>
                <th>Open</th>
                <td>{{ horaire.open ? horaire.open|date('H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Close</th>
                <td>{{ horaire.close ? horaire.close|date('H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_horaires_crud_index') }}">back to list</a>

    <a href="{{ path('app_horaires_crud_edit', {'id': horaire.id}) }}">edit</a>

    {{ include('horaires_crud/_delete_form.html.twig') }}
{% endblock %}
