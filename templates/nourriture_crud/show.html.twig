{% extends 'base.html.twig' %}

{% block title %}Nourriture
{% endblock %}

{% block body %}
	<h1 class="text-center">Nourriture</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Id</th>
				<td>{{ nourriture.id }}</td>
			</tr>
			<tr>
				<th>Nom</th>
				<td>{{ nourriture.name }}</td>
			</tr>
		</tbody>
	</table>
	<div class="d-flex justify-content-center gap-5 my-4">
		<a href="{{ path('app_nourriture_crud_index') }}" class="btn button">Retour à la liste</a>

		<a href="{{ path('app_nourriture_crud_edit', {'id': nourriture.id}) }}" class="btn button">Éditer</a>

		{{ include('nourriture_crud/_delete_form.html.twig') }}

	</div>
{% endblock %}
