{% extends 'base.html.twig' %}

{% block title %}
	{{ login }}
{% endblock %}

{% block body %}
	{% if app.user %}
		<div class="mb-3 text-center">
			Vous êtes connecté en tant que
			{{ app.user.userIdentifier }}
			<a href="{{ path('app_logout') }}" class="button btn">Se déconnecter</a>
		</div>
	{% endif %}

	<form method="post" class="login-form my-5 {% if app.user %}d-none{% endif %}">
		{% if error %}
			<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
		{% endif %}

		<h1 class="h2 mb-3 font-weight-normal">Connexion</h1>
		<div class="form-group">
			<label for="username">Email</label>
			<input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
		</div>
		<div class="form-group">
			<label for="password">Mot de Passe</label>
			<input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
		</div>

		<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

		<div class="form-check mb-3">
			<input type="checkbox" class="form-check-input" name="_remember_me" id="_remember_me">
			<label class="form-check-label" for="_remember_me">Se souvenir de moi</label>
		</div>

		<button class="btn button" type="submit">
			Se Connecter
		</button>
	</form>
{% endblock %}
